diff --git a/app/src/io/freemytv/GlassHome.java b/app/src/io/freemytv/GlassHome.java
new file mode 100644
index 0000000..29e23f3
--- /dev/null
+++ b/app/src/io/freemytv/GlassHome.java
@@ -0,0 +1,246 @@
+package io.freemytv;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.graphics.Bitmap;
+import android.net.Uri;
+import android.os.Build;
+import android.view.KeyEvent;
+import android.view.View;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * The "glass" home screen (config.properties: home_style=glass): a web page in assets/glass drawn by the TV's WebView,
+ * over a sunset it paints itself, with a frosted side menu and the apps by category. Everything it opens goes through
+ * HomeApps, as on the regular home screen, and the weather comes from HomeData (both cities).
+ */
+final class GlassHome {
+    private final Activity activity;
+    private final WebView web;
+    private final HomeData data;
+    private final Map<String, HomeApps.Item> items = new ConcurrentHashMap<>();
+    private final Map<String, byte[]> icons = new ConcurrentHashMap<>();
+    private final HomeData.Listener onData = this::weatherChanged;
+    private boolean loaded;
+
+    /** Packages by category, beyond what the apps say of themselves (ApplicationInfo.category). */
+    private static final Set<String> MOVIES = new HashSet<>(Arrays.asList(
+            "com.netflix.ninja", "com.amazon.amazonvideo.livingroom", "com.disney.disneyplus", "com.wbd.stream",
+            "com.hbo.hbonow", "com.globo.globotv", "com.apple.atve.androidtv.appletv", "com.cbs.ott", "com.stremio.one",
+            "com.world.youcinetv", "com.google.android.youtube.tv", "org.smarttube.stable", "org.smarttube.beta",
+            "com.google.android.videos", "com.crunchyroll.crunchyroid", "com.plexapp.android", "org.jellyfin.androidtv",
+            "org.xbmc.kodi", "com.mubi", "br.com.telecine.android", "com.claro.claroflex", "com.netflix.mediaclient"));
+    private static final Set<String> MUSIC = new HashSet<>(Arrays.asList(
+            "com.spotify.tv.android", "com.google.android.youtube.tvmusic", "com.ilv.vradio", "deezer.android.tv",
+            "com.amazon.music.tv", "com.aspiro.tidal", "com.soundcloud.android"));
+    private static final Set<String> LIVE = new HashSet<>(Arrays.asList(
+            "tv.pluto.android", "com.google.android.tv", "com.samsung.tvplus", "com.tcl.channelplus"));
+    /** Never in the grids: this app itself and the TV's own home screens. */
+    private static final Set<String> HIDDEN = new HashSet<>(Arrays.asList(
+            "io.freemytv", "com.google.android.apps.tv.launcherx", "com.google.android.tvlauncher",
+            "com.tcl.tv.tclhome_passive"));
+
+    GlassHome(Activity a) {
+        activity = a;
+        data = HomeData.get(a);
+        web = new WebView(a);
+        WebSettings s = web.getSettings();
+        s.setJavaScriptEnabled(true);
+        s.setDomStorageEnabled(true);   // the favorites
+        s.setAllowFileAccess(true);
+        s.setMediaPlaybackRequiresUserGesture(true);
+        s.setTextZoom(100);
+        s.setMinimumFontSize(1);
+        // The page is laid out at 1920 x 1080 (its viewport) and scaled to the screen, whatever the TV's density.
+        s.setUseWideViewPort(true);
+        s.setLoadWithOverviewMode(true);
+        web.setBackgroundColor(0xFF1B1036);
+        web.setVerticalScrollBarEnabled(false);
+        web.setHorizontalScrollBarEnabled(false);
+        web.setFocusable(true);
+        web.setFocusableInTouchMode(true);
+        web.addJavascriptInterface(new Bridge(), "TV");
+        web.setWebViewClient(new WebViewClient() {
+            @Override public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest req) {
+                Uri u = req.getUrl();
+                if (!"tv.local".equals(u.getHost()) || u.getPath() == null || !u.getPath().startsWith("/icon/")) return null;
+                byte[] png = icon(u.getLastPathSegment());
+                if (png == null) return new WebResourceResponse("text/plain", "utf-8", 404, "Not Found", null, null);
+                return new WebResourceResponse("image/png", null, new ByteArrayInputStream(png));
+            }
+
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest req) {
+                return true;   // the page never goes anywhere else
+            }
+
+            @Override public void onPageFinished(WebView view, String url) {
+                loaded = true;
+                web.requestFocus();
+            }
+        });
+        web.loadUrl("file:///android_asset/glass/index.html");
+        data.addListener(onData);
+    }
+
+    View view() { return web; }
+
+    void resume() {
+        web.onResume();
+        web.requestFocus();
+        data.refreshIfStale();
+        js("window.onResume && onResume()");
+    }
+
+    void pause() { web.onPause(); }
+
+    /** Home pressed on the home screen: back to the start. */
+    void reset() { js("window.reset && reset()"); }
+
+    void destroy() {
+        data.removeListener(onData);
+        web.destroy();
+    }
+
+    /** Back stays on the home screen: the page decides (closes a section, goes back to the menu). */
+    boolean onKey(KeyEvent e) {
+        if (e.getKeyCode() != KeyEvent.KEYCODE_BACK) return false;
+        if (e.getAction() == KeyEvent.ACTION_UP) js("window.onBack && onBack()");
+        return true;
+    }
+
+    private void weatherChanged() { js("window.onWeather && onWeather()"); }
+
+    private void js(String code) {
+        if (loaded) web.evaluateJavascript(code, null);
+    }
+
+    private byte[] icon(String id) {
+        byte[] cached = icons.get(id);
+        if (cached != null) return cached;
+        HomeApps.Item it = items.get(id);
+        if (it == null || it.pkg == null) return null;
+        Bitmap b = HomeApps.tileFor(activity, it.pkg);
+        if (b == null) return null;
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        b.compress(Bitmap.CompressFormat.PNG, 100, out);
+        byte[] png = out.toByteArray();
+        icons.put(id, png);
+        return png;
+    }
+
+    private static String category(Context c, String pkg) {
+        if (MUSIC.contains(pkg)) return "music";
+        if (LIVE.contains(pkg)) return "live";
+        if (MOVIES.contains(pkg)) return "movies";
+        try {
+            ApplicationInfo ai = c.getPackageManager().getApplicationInfo(pkg, 0);
+            if (Build.VERSION.SDK_INT >= 26) {
+                if (ai.category == ApplicationInfo.CATEGORY_GAME) return "games";
+                if (ai.category == ApplicationInfo.CATEGORY_AUDIO) return "music";
+                if (ai.category == ApplicationInfo.CATEGORY_VIDEO) return "movies";
+            }
+            if ((ai.flags & ApplicationInfo.FLAG_IS_GAME) != 0) return "games";
+        } catch (PackageManager.NameNotFoundException ignored) {
+        }
+        return "other";
+    }
+
+    private static JSONObject wx(HomeData.Weather w, String city) throws Exception {
+        JSONObject o = new JSONObject().put("city", city);
+        if (Double.isNaN(w.temp)) return o.put("ok", false);
+        o.put("ok", true).put("temp", HomeData.degrees(w.temp)).put("cond", HomeData.condition(w.code, w.isDay))
+                .put("icon", Symbols.weather(w.code, w.isDay))
+                .put("max", HomeData.degrees(w.max)).put("min", HomeData.degrees(w.min));
+        JSONArray hours = new JSONArray();
+        for (int i = 0; i < w.hours.size() && i < 6; i++) {
+            hours.put(new JSONObject().put("t", HomeData.hour(w.hours.get(i))).put("temp", HomeData.degrees(w.hourTemp.get(i)))
+                    .put("icon", Symbols.weather(w.hourCode.get(i), w.hourDay.get(i))));
+        }
+        o.put("hours", hours);
+        if (w.sunrise != 0) o.put("sunrise", Ui.time(w.sunrise));
+        if (w.sunset != 0) o.put("sunset", Ui.time(w.sunset));
+        return o;
+    }
+
+    private final class Bridge {
+        /** Everything the page can show: apps (with their category), live TV and inputs, settings. */
+        @JavascriptInterface public String items() {
+            JSONArray out = new JSONArray();
+            try {
+                Map<String, HomeApps.Item> next = new HashMap<>();
+                for (String[] app : HomeApps.launchable(activity)) {
+                    String pkg = app[0];
+                    if (HIDDEN.contains(pkg) || HomeApps.isHidden(pkg)) continue;
+                    String id = "app-" + pkg;
+                    next.put(id, HomeApps.app(pkg, app[1]));
+                    out.put(new JSONObject().put("id", id).put("kind", "app").put("label", app[1]).put("pkg", pkg)
+                            .put("cat", category(activity, pkg)));
+                }
+                int n = 0;
+                for (HomeApps.Item it : HomeApps.allInputs(activity)) {
+                    String id = "in-" + (n++);
+                    next.put(id, it);
+                    out.put(new JSONObject().put("id", id).put("kind", it.kind == HomeApps.LIVE_TV ? "live" : "input")
+                            .put("label", it.label).put("symbol", it.symbol == null ? "hdmi" : it.symbol)
+                            .put("connected", it.connected).put("cat", "live"));
+                }
+                HomeApps.Item home = HomeApps.settings(), tv = HomeApps.tvSettings();
+                next.put("set-home", home);
+                next.put("set-tv", tv);
+                out.put(new JSONObject().put("id", "set-home").put("kind", "setting").put("label", "Ajustes do Free My TV")
+                        .put("symbol", "sparkles").put("cat", "settings"));
+                out.put(new JSONObject().put("id", "set-tv").put("kind", "setting").put("label", "Ajustes da TV")
+                        .put("symbol", "tv_settings").put("cat", "settings"));
+                items.clear();
+                items.putAll(next);
+            } catch (Exception e) {
+                AppLog.w("glass: items: " + e.getMessage());
+            }
+            return out.toString();
+        }
+
+        @JavascriptInterface public void open(String id) {
+            HomeApps.Item it = items.get(id);
+            if (it == null) return;
+            activity.runOnUiThread(() -> {
+                if (!HomeApps.open(activity, it, null)) AppLog.w("glass: couldn't open " + id);
+            });
+        }
+
+        /** Both cities' weather (the second only with city2 in config.properties). */
+        @JavascriptInterface public String weather() {
+            try {
+                JSONObject o = new JSONObject();
+                o.put("main", wx(data.weather, Prefs.city().isEmpty() ? "Clima" : Prefs.city()));
