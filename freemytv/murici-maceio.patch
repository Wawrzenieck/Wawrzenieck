diff --git a/app/assets/glass/glass.css b/app/assets/glass/glass.css
new file mode 100644
index 0000000..c36417b
--- /dev/null
+++ b/app/assets/glass/glass.css
@@ -0,0 +1,142 @@
+@font-face {
+  font-family: "Inter";
+  src: url("../fonts/InterVariable.ttf") format("truetype");
+  font-weight: 100 900;
+}
+
+:root {
+  --ink: #fff;
+  --dim: rgba(255, 255, 255, 0.72);
+  --faint: rgba(255, 255, 255, 0.5);
+  --line: rgba(255, 255, 255, 0.22);
+  --frost: none;   /* the blurred sky, set by glass.js */
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+html, body {
+  width: 1920px;
+  height: 1080px;
+  overflow: hidden;
+  background: #1b1036;
+  color: var(--ink);
+  font-family: "Inter", sans-serif;
+  -webkit-font-smoothing: antialiased;
+  cursor: none;
+  user-select: none;
+}
+
+#sky { position: fixed; left: 0; top: 0; width: 1920px; height: 1080px; }
+
+/* Frosted glass: the same sky, blurred, fixed to the screen so it lines up with what's behind. */
+.glass {
+  background-image: linear-gradient(160deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05)), var(--frost);
+  background-attachment: fixed, fixed;
+  background-size: 1920px 1080px, 1920px 1080px;
+  border: 1.5px solid var(--line);
+  box-shadow: 0 30px 80px rgba(10, 0, 30, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25);
+  border-radius: 36px;
+}
+
+/* MARK: - Left column: clock, menu, hints */
+
+#side { position: fixed; left: 84px; top: 70px; width: 400px; }
+
+#clock { padding-left: 8px; text-shadow: 0 4px 30px rgba(40, 0, 40, 0.45); }
+#time { font-size: 132px; font-weight: 250; letter-spacing: -4px; line-height: 1; }
+#date { font-size: 32px; font-weight: 450; color: var(--dim); margin-top: 10px; text-transform: lowercase; }
+#date::first-letter { text-transform: uppercase; }
+
+#menu { margin-top: 40px; padding: 18px; display: flex; flex-direction: column; gap: 4px; }
+
+.m {
+  display: flex; align-items: center; gap: 22px;
+  height: 72px; padding: 0 24px;
+  border: 0; border-radius: 22px;
+  background: transparent;
+  color: var(--dim);
+  font: 500 30px "Inter", sans-serif;
+  text-align: left;
+  transition: background 0.18s, color 0.18s, transform 0.18s;
+}
+.m img { width: 34px; height: 34px; opacity: 0.8; transition: filter 0.18s; }
+.m.current { background: rgba(255, 255, 255, 0.14); color: #fff; }
+.m.current img { opacity: 1; }
+.m.focused { background: #fff; color: #1d1230; transform: scale(1.04); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); }
+.m.focused img { opacity: 1; filter: brightness(0) saturate(100%) invert(9%) sepia(30%) saturate(2000%) hue-rotate(250deg); }
+
+#hint { margin-top: 34px; padding-left: 12px; font-size: 22px; color: var(--faint); line-height: 1.6; }
+#hint b { color: var(--dim); font-weight: 600; }
+#hint .dot { display: inline-block; width: 12px; height: 12px; border-radius: 6px; background: #ffc542; vertical-align: 1px; margin-right: 4px; }
+
+/* MARK: - Panel */
+
+#panel {
+  position: fixed; left: 540px; top: 250px; right: 84px; bottom: 70px;
+  padding: 44px 0 0 52px;
+  overflow: hidden;
+}
+#title { font-size: 46px; font-weight: 650; letter-spacing: -0.5px; margin-bottom: 28px; text-shadow: 0 2px 20px rgba(40, 0, 40, 0.35); }
+#content { position: absolute; left: 0; right: 0; top: 118px; bottom: 0; overflow: hidden; padding: 24px 52px 60px 52px; }
+#scroller { transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1); }
+
+h2 { font-size: 28px; font-weight: 600; color: var(--dim); margin: 0 0 18px 6px; }
+
+.grid { display: flex; flex-wrap: wrap; gap: 34px 30px; margin-bottom: 36px; }
+
+/* App tile: the app's TV art, rounded, with its name below; focused, it grows and lights up. */
+.t { width: 236px; transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1); }
+.t .art {
+  position: relative;
+  width: 236px; height: 133px;
+  border-radius: 22px;
+  overflow: hidden;
+  background: linear-gradient(150deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.06));
+  box-shadow: 0 12px 30px rgba(20, 0, 40, 0.35);
+  border: 1.5px solid rgba(255, 255, 255, 0.18);
+  transition: box-shadow 0.2s, border-color 0.2s;
+}
+.t .art img.banner { width: 100%; height: 100%; object-fit: cover; display: block; }
+.t .art img.sym { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; }
+.t .art .letter { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 56px; font-weight: 700; }
+.t .name { margin-top: 14px; text-align: center; font-size: 23px; font-weight: 500; color: var(--dim);
+  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.t.off { opacity: 0.45; }
+.t .star { position: absolute; right: 10px; top: 10px; width: 16px; height: 16px; border-radius: 8px; background: #ffc542;
+  box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.25); }
+.t.focused { transform: scale(1.1) translateY(-6px); z-index: 2; }
+.t.focused .art { border-color: #fff; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.95), 0 24px 50px rgba(20, 0, 40, 0.55); }
+.t.focused .name { color: #fff; font-weight: 600; }
+.t.holding .art { box-shadow: 0 0 0 6px #ffc542, 0 24px 50px rgba(20, 0, 40, 0.55); }
+
+/* MARK: - Weather (home) */
+
+.wx-row { display: flex; gap: 30px; margin-bottom: 26px; }
+.wx {
+  flex: 1;
+  padding: 24px 34px 22px;
+  border-radius: 28px;
+  background: linear-gradient(150deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04));
+  border: 1.5px solid rgba(255, 255, 255, 0.16);
+}
+.wx .city { font-size: 26px; font-weight: 600; color: var(--dim); }
+.wx .now { display: flex; align-items: center; gap: 20px; margin-top: 8px; }
+.wx .now img { width: 74px; height: 74px; }
+.wx .temp { font-size: 72px; font-weight: 300; letter-spacing: -2px; }
+.wx .cond { font-size: 26px; font-weight: 500; }
+.wx .hl { font-size: 22px; color: var(--faint); margin-top: 6px; }
+.wx .hours { display: flex; justify-content: space-between; margin-top: 14px; padding-top: 14px; border-top: 1.5px solid rgba(255, 255, 255, 0.14); }
+.wx .h { text-align: center; font-size: 20px; color: var(--faint); }
+.wx .h img { display: block; width: 28px; height: 28px; margin: 6px auto; }
+.wx .h b { font-size: 22px; color: #fff; font-weight: 550; }
+.wx .sun { margin-top: 10px; font-size: 20px; color: var(--faint); }
+
+.empty { font-size: 26px; color: var(--faint); padding: 10px 6px; }
+
+#toast {
+  position: fixed; left: 50%; bottom: 40px; transform: translate(-50%, 30px);
+  padding: 16px 30px; border-radius: 40px;
+  background: rgba(20, 10, 40, 0.75); border: 1.5px solid var(--line);
+  font-size: 24px; opacity: 0; transition: opacity 0.25s, transform 0.25s;
+}
+#toast.on { opacity: 1; transform: translate(-50%, 0); }
diff --git a/app/assets/glass/glass.js b/app/assets/glass/glass.js
new file mode 100644
index 0000000..0a88fb5
--- /dev/null
+++ b/app/assets/glass/glass.js
@@ -0,0 +1,569 @@
+/* The glass home screen: a sunset painted once, a frosted side menu, and the apps by category.
+ * Talks to the app through window.TV (GlassHome.Bridge): items(), open(id), weather(), refresh(). */
+"use strict";
+
+var W = 1920, H = 1080;
+var bridge = window.TV || mockBridge();
+
+// MARK: - The sky
+
+function rng(seed) {
+  return function () {
+    seed = (seed * 1664525 + 1013904223) >>> 0;
+    return seed / 4294967296;
+  };
+}
+
+/** A ridge line across the screen (midpoint displacement), as y values every `step` px. */
+function ridge(r, base, rough, step) {
+  var n = Math.ceil(W / step) + 1, ys = new Array(n);
+  ys[0] = base + (r() - 0.5) * rough;
+  ys[n - 1] = base + (r() - 0.5) * rough;
+  (function split(a, b, amp) {
+    if (b - a < 2) return;
+    var m = (a + b) >> 1;
+    ys[m] = (ys[a] + ys[b]) / 2 + (r() - 0.5) * amp;
+    split(a, m, amp * 0.55);
+    split(m, b, amp * 0.55);
+  })(0, n - 1, rough * 2);
+  return ys;
+}
+
+function fillRidge(c, ys, step, bottom, color) {
+  c.beginPath();
+  c.moveTo(0, bottom);
+  for (var i = 0; i < ys.length; i++) c.lineTo(i * step, ys[i]);
+  c.lineTo(W, bottom);
+  c.closePath();
+  c.fillStyle = color;
+  c.fill();
+}
+
+function pine(c, x, base, h, color) {
+  c.fillStyle = color;
+  c.fillRect(x - h * 0.02, base - h * 0.15, h * 0.04, h * 0.15);
+  for (var i = 0; i < 6; i++) {
+    var y = base - h * 0.12 - i * h * 0.15, w = h * (0.32 - i * 0.045);
+    c.beginPath();
+    c.moveTo(x - w, y);
+    c.lineTo(x, y - h * 0.26);
+    c.lineTo(x + w, y);
+    c.closePath();
+    c.fill();
+  }
+}
+
+function paintSky(canvas) {
+  canvas.width = W;
+  canvas.height = H;
+  var c = canvas.getContext("2d"), r = rng(20261106);
+  var horizon = H * 0.64;
+
+  // Sky: night blue at the top, through violet and magenta, to the orange glow at the horizon.
+  var g = c.createLinearGradient(0, 0, 0, horizon);
+  g.addColorStop(0, "#120a2e");
+  g.addColorStop(0.28, "#33195a");
+  g.addColorStop(0.55, "#7d2a73");
+  g.addColorStop(0.78, "#d9506a");
+  g.addColorStop(0.92, "#f58b4c");
+  g.addColorStop(1, "#ffc46b");
+  c.fillStyle = g;
+  c.fillRect(0, 0, W, horizon + 2);
+
+  // Stars, fading out toward the glow.
+  for (var i = 0; i < 260; i++) {
+    var sy = r() * horizon * 0.55, a = (1 - sy / (horizon * 0.55)) * (0.35 + r() * 0.65);
+    c.fillStyle = "rgba(255,255,255," + a.toFixed(2) + ")";
+    var s = r() < 0.08 ? 2.4 : 1.3;
+    c.fillRect(r() * W, sy, s, s);
+  }
+
+  // A big ringed planet, low in the sky on the right.
+  var px = W * 0.7, py = H * 0.2, pr = 150;
+  var pg = c.createRadialGradient(px - pr * 0.45, py - pr * 0.5, pr * 0.1, px, py, pr);
+  pg.addColorStop(0, "#ffd9b0");
+  pg.addColorStop(0.45, "#e0866e");
+  pg.addColorStop(0.8, "#7a3263");
+  pg.addColorStop(1, "#3a1846");
+  c.save();
+  c.translate(px, py);
+  c.rotate(-0.32);
+  c.strokeStyle = "rgba(255,214,190,0.35)";
+  c.lineWidth = 10;
+  c.beginPath();
+  c.ellipse(0, 0, pr * 1.9, pr * 0.42, 0, Math.PI, 2 * Math.PI);   // the far half of the ring, behind the planet
+  c.stroke();
+  c.restore();
+  c.fillStyle = pg;
+  c.beginPath();
+  c.arc(px, py, pr, 0, 2 * Math.PI);
+  c.fill();
+  c.save();
+  c.beginPath();
+  c.arc(px, py, pr, 0, 2 * Math.PI);
+  c.clip();
+  c.translate(px, py);
+  c.rotate(-0.32);   // the bands follow the ring's tilt
+  c.filter = "blur(6px)";
+  c.globalAlpha = 0.16;
+  for (var b = -4; b <= 4; b++) {   // soft bands
+    c.fillStyle = b % 2 ? "#fff1dd" : "#6b2260";
+    c.fillRect(-pr * 1.2, b * pr * 0.22 - pr * 0.05, pr * 2.4, pr * 0.1);
+  }
+  c.restore();
+  c.save();
+  c.translate(px, py);
+  c.rotate(-0.32);
+  c.strokeStyle = "rgba(255,226,205,0.6)";
+  c.lineWidth = 9;
+  c.beginPath();
+  c.ellipse(0, 0, pr * 1.9, pr * 0.42, 0, 0, Math.PI);   // the near half, in front
+  c.stroke();
+  c.strokeStyle = "rgba(255,226,205,0.22)";
+  c.lineWidth = 22;
+  c.beginPath();
+  c.ellipse(0, 0, pr * 1.62, pr * 0.34, 0, 0, Math.PI);
+  c.stroke();
+  c.restore();
+  // A small moon on the left.
+  var mg = c.createRadialGradient(W * 0.37 - 14, H * 0.13 - 14, 4, W * 0.37, H * 0.13, 46);
+  mg.addColorStop(0, "#fde6d2");
+  mg.addColorStop(1, "#8a4a74");
+  c.fillStyle = mg;
+  c.beginPath();
+  c.arc(W * 0.37, H * 0.13, 46, 0, 2 * Math.PI);
+  c.fill();
+
+  // The sun setting on the left, with its glow.
+  var sx = W * 0.3, sunY = horizon - 18;
+  var glow = c.createRadialGradient(sx, sunY, 10, sx, sunY, 620);
+  glow.addColorStop(0, "rgba(255,226,160,0.95)");
+  glow.addColorStop(0.12, "rgba(255,170,90,0.6)");
+  glow.addColorStop(0.45, "rgba(240,90,90,0.18)");
+  glow.addColorStop(1, "rgba(240,90,90,0)");
+  c.fillStyle = glow;
+  c.fillRect(0, 0, W, horizon);
+  c.fillStyle = "#fff4d6";
+  c.beginPath();
+  c.arc(sx, sunY, 70, 0, 2 * Math.PI);
+  c.fill();
+
+  // Clouds: soft streaks lit from below.
+  c.save();
+  c.filter = "blur(14px)";
+  for (var k = 0; k < 16; k++) {
+    var cy = H * (0.3 + r() * 0.28), cx = r() * W, cw = 180 + r() * 380;
+    var near = (cy - H * 0.3) / (H * 0.28);
+    c.fillStyle = "rgba(" + (255) + "," + Math.round(140 + near * 60) + "," + Math.round(150 - near * 40) + "," + (0.18 + r() * 0.2).toFixed(2) + ")";
+    c.beginPath();
+    c.ellipse(cx, cy, cw, 10 + r() * 18, 0, 0, 2 * Math.PI);
+    c.fill();
+  }
+  c.restore();
+
+  // Mountains: three ranges, hazy in the distance, dark up close.
+  var far = ridge(r, horizon - 120, 110, 16), mid = ridge(r, horizon - 50, 90, 12), near2 = ridge(r, horizon - 6, 40, 10);
+  fillRidge(c, far, 16, horizon + 2, "#7b3a78");
+  c.fillStyle = "rgba(255,150,120,0.16)";
+  c.fillRect(0, horizon - 200, W, 200);
+  fillRidge(c, mid, 12, horizon + 2, "#4a1f55");
+  fillRidge(c, near2, 10, horizon + 2, "#25112f");
+
+  // The lake: the sky mirrored, darker, with the sun's path on the water.
+  c.save();
+  c.translate(0, horizon * 2);
+  c.scale(1, -1);
+  c.globalAlpha = 0.55;
+  c.drawImage(canvas, 0, 0, W, horizon, 0, 0, W, horizon);
+  c.restore();
+  var water = c.createLinearGradient(0, horizon, 0, H);
+  water.addColorStop(0, "rgba(40,12,50,0.35)");
+  water.addColorStop(1, "rgba(14,6,30,0.92)");
+  c.fillStyle = water;
+  c.fillRect(0, horizon, W, H - horizon);
+  for (var l = 0; l < 90; l++) {
+    var ly = horizon + 6 + Math.pow(r(), 1.6) * (H - horizon - 10);
+    var spread = 40 + (ly - horizon) * 0.55, lw = 20 + r() * spread;
+    var lx = sx + (r() - 0.5) * spread * 1.4;
+    c.fillStyle = "rgba(255,200,140," + (0.5 * (1 - (ly - horizon) / (H - horizon))).toFixed(2) + ")";
+    c.fillRect(lx - lw / 2, ly, lw, 2 + r() * 2);
+  }
+  c.fillStyle = "rgba(255,255,255,0.05)";
+  for (var q = 0; q < 140; q++) c.fillRect(r() * W, horizon + r() * (H - horizon), 30 + r() * 90, 1.5);
+
+  // Pines on both shores.
+  for (var p = 0; p < 9; p++) pine(c, W - 30 - p * 52 - r() * 30, horizon + 30 + r() * 30, 230 + r() * 180, "#0d0616");
+  for (var p2 = 0; p2 < 4; p2++) pine(c, 20 + p2 * 46 + r() * 20, horizon + 20 + r() * 20, 150 + r() * 110, "#0d0616");
+
+  // Vignette.
+  var v = c.createRadialGradient(W / 2, H / 2, H * 0.45, W / 2, H / 2, H * 1.05);
+  v.addColorStop(0, "rgba(0,0,0,0)");
+  v.addColorStop(1, "rgba(8,0,20,0.55)");
+  c.fillStyle = v;
+  c.fillRect(0, 0, W, H);
+
+  // The frost: the same picture, blurred, behind the glass panels.
+  var f = document.createElement("canvas");
+  f.width = W / 4;
+  f.height = H / 4;
+  var fc = f.getContext("2d");
+  fc.filter = "blur(9px) saturate(1.2)";
+  fc.drawImage(canvas, -20, -20, W / 4 + 40, H / 4 + 40);
+  document.documentElement.style.setProperty("--frost", "url(" + f.toDataURL("image/jpeg", 0.85) + ")");
+}
+
+// MARK: - Clock
+
+var WEEKDAYS = ["domingo", "segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira", "sábado"];
+var MONTHS = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
+
+function tick() {
+  var d = new Date();
+  var hh = String(d.getHours()).padStart(2, "0"), mm = String(d.getMinutes()).padStart(2, "0");
+  document.getElementById("time").textContent = hh + ":" + mm;
+  document.getElementById("date").textContent = WEEKDAYS[d.getDay()] + ", " + d.getDate() + " de " + MONTHS[d.getMonth()];
+  setTimeout(tick, 60000 - (d.getSeconds() * 1000 + d.getMilliseconds()) + 50);
+}
+
+// MARK: - Data
+
+var items = [], weather = {};
+var SECTIONS = {
+  home: "Início", apps: "Apps", movies: "Filmes e Séries", live: "TV ao Vivo",
+  games: "Jogos", music: "Música", settings: "Configurações"
+};
+var DEFAULT_FAVS = ["org.smarttube.stable", "com.google.android.youtube.tv", "com.stremio.one", "com.world.youcinetv",
+  "com.netflix.ninja", "com.globo.globotv", "com.spotify.tv.android", "com.amazon.amazonvideo.livingroom", "com.disney.disneyplus"];
+
+function load(key, fallback) {
+  try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; } catch (e) { return fallback; }
+}
+function save(key, v) {
+  try { localStorage.setItem(key, JSON.stringify(v)); } catch (e) {}
+}
+
+var favs = load("favs", null);
+
+function loadItems() {
+  try { items = JSON.parse(bridge.items()); } catch (e) { items = []; }
+  if (!favs) {
+    favs = [];
+    DEFAULT_FAVS.forEach(function (p) { if (items.some(function (it) { return it.pkg === p; })) favs.push(p); });
+    save("favs", favs);
+  }
+}
+
+function loadWeather() {
+  try { weather = JSON.parse(bridge.weather()); } catch (e) { weather = {}; }
+}
+
+function isFav(it) { return it.pkg && favs.indexOf(it.pkg) >= 0; }
+
+function itemsFor(sec) {
+  if (sec === "apps") return items.filter(function (it) { return it.kind === "app"; })
+    .sort(function (a, b) { return a.label.localeCompare(b.label, "pt"); });
+  if (sec === "home") return favs.map(function (p) { return items.filter(function (it) { return it.pkg === p; })[0]; })
+    .filter(Boolean);
+  return items.filter(function (it) { return it.cat === sec; });
+}
+
+// MARK: - Drawing
+
+function el(tag, cls, text) {
+  var e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text != null) e.textContent = text;
+  return e;
+}
+
+function tile(it) {
+  var t = el("div", "t f" + (it.connected === false ? " off" : ""));
+  t.dataset.id = it.id;
+  var art = el("div", "art");
+  if (it.kind === "app") {
+    var img = el("img", "banner");
+    img.src = "https://tv.local/icon/" + encodeURIComponent(it.id);
+    img.onerror = function () { img.remove(); art.appendChild(el("div", "letter", it.label.charAt(0))); };
+    art.appendChild(img);
+    if (isFav(it)) art.appendChild(el("div", "star"));
+  } else {
+    var s = el("img", "sym");
+    s.src = "../symbols/" + it.symbol + ".png";
+    art.appendChild(s);
+  }
+  t.appendChild(art);
+  t.appendChild(el("div", "name", it.label));
+  return t;
+}
+
+function weatherCard(w) {
+  var card = el("div", "wx");
+  card.appendChild(el("div", "city", w.city));
+  if (!w.ok) {
+    card.appendChild(el("div", "hl", "Sem dados do clima agora."));
+    return card;
+  }
+  var now = el("div", "now"), icon = el("img");
+  icon.src = "../symbols/" + w.icon + ".png";
+  now.appendChild(icon);
+  now.appendChild(el("div", "temp", w.temp));
+  var right = el("div");
+  right.appendChild(el("div", "cond", w.cond));
+  right.appendChild(el("div", "hl", "Máx. " + w.max + "   Mín. " + w.min));
+  now.appendChild(right);
+  card.appendChild(now);
+  var hours = el("div", "hours");
+  (w.hours || []).forEach(function (h) {
+    var e = el("div", "h");
+    e.appendChild(document.createTextNode(h.t));
+    var i = el("img");
+    i.src = "../symbols/" + h.icon + ".png";
+    e.appendChild(i);
+    e.appendChild(el("b", null, h.temp));
+    hours.appendChild(e);
+  });
+  card.appendChild(hours);
+  if (w.sunrise) card.appendChild(el("div", "sun", "Nascer do sol " + w.sunrise + "   ·   Pôr do sol " + w.sunset));
+  return card;
+}
+
+var section = "home";
+
+function render(sec) {
+  section = sec;
+  document.getElementById("title").textContent = sec === "home" ? greeting() : SECTIONS[sec];
+  var menu = document.querySelectorAll(".m");
+  for (var i = 0; i < menu.length; i++) menu[i].classList.toggle("current", menu[i].dataset.sec === sec);
+  var content = document.getElementById("content");
+  content.innerHTML = "";
+  var scroller = el("div");
+  scroller.id = "scroller";
+  content.appendChild(scroller);
+  shift = 0;
+  if (sec === "home") {
+    var row = el("div", "wx-row");
+    if (weather.main) row.appendChild(weatherCard(weather.main));
+    if (weather.second) row.appendChild(weatherCard(weather.second));
+    if (row.children.length) scroller.appendChild(row);
+    scroller.appendChild(el("h2", null, "Favoritos"));
+  }
+  var list = itemsFor(sec), grid = el("div", "grid");
+  list.forEach(function (it) { grid.appendChild(tile(it)); });
+  if (list.length) scroller.appendChild(grid);
+  else scroller.appendChild(el("div", "empty", sec === "home"
+    ? "Nenhum favorito ainda: em Apps, segure OK num app para favoritar."
+    : "Nada aqui por enquanto."));
+}
+
+function greeting() {
+  var h = new Date().getHours();
+  return h < 5 ? "Boa noite" : h < 12 ? "Bom dia" : h < 18 ? "Boa tarde" : "Boa noite";
+}
+
+// MARK: - Focus and the remote
+
+var zone = "menu", menuIndex = 0, focused = null;
+
+function menuButtons() { return Array.prototype.slice.call(document.querySelectorAll(".m")); }
+function tiles() { return Array.prototype.slice.call(document.querySelectorAll("#content .t")); }
+
+function setFocus(e) {
+  if (focused) focused.classList.remove("focused");
+  focused = e;
+  if (e) e.classList.add("focused");
+  if (e && zone === "content") keepVisible(e);
+}
+
+var shift = 0;
+
+/** Scrolls the panel so the focused tile (and its name) shows; back at the top whenever that fits. */
+function keepVisible(e) {
+  var scroller = document.getElementById("scroller"), content = document.getElementById("content");
+  var view = content.clientHeight - 40;
+  var top = e.getBoundingClientRect().top - scroller.getBoundingClientRect().top - 24;   // unaffected by the scroll
+  var bottom = top + e.offsetHeight + 60;
+  if (bottom <= view) shift = 0;
+  else if (bottom - shift > view) shift = bottom - view;
+  else if (top - shift < 0) shift = top;
+  scroller.style.transform = "translateY(" + (-shift) + "px)";
+}
+
+function focusMenu(i) {
+  var b = menuButtons();
+  zone = "menu";
+  menuIndex = Math.max(0, Math.min(b.length - 1, i));
+  setFocus(b[menuIndex]);
+  if (b[menuIndex].dataset.sec !== section) render(b[menuIndex].dataset.sec);
+}
+
+function focusContent() {
+  var t = tiles();
+  if (!t.length) return;
+  zone = "content";
+  setFocus(t[0]);
+}
+
+/** The nearest tile in a direction, by screen position. */
+function nearest(from, dx, dy) {
+  var a = from.getBoundingClientRect(), ax = a.left + a.width / 2, ay = a.top + a.height / 2, best = null, bestScore = 1e9;
+  tiles().forEach(function (t) {
+    if (t === from) return;
+    var b = t.getBoundingClientRect(), bx = b.left + b.width / 2, by = b.top + b.height / 2;
+    var px = (bx - ax) * dx, py = (by - ay) * dy;
+    if (dx && px <= 4) return;
+    if (dy && py <= 4) return;
+    var along = dx ? px : py, across = dx ? Math.abs(by - ay) : Math.abs(bx - ax);
+    var score = along + across * (dy ? 0.6 : 3);
+    if (score < bestScore) { bestScore = score; best = t; }
+  });
+  return best;
+}
+
+function move(dx, dy) {
+  if (zone === "menu") {
+    if (dy) focusMenu(menuIndex + dy);
+    else if (dx > 0) focusContent();
+    return;
+  }
+  var next = nearest(focused, dx, dy);
+  if (next) setFocus(next);
+  else if (dx < 0) focusMenu(menuIndex);
+}
+
+var holdTimer = null, held = false;
+
+function okDown(e) {
+  if (e.repeat || holdTimer) return;
+  held = false;
+  if (zone !== "content" || !focused) return;
+  var it = byId(focused.dataset.id);
+  if (!it || !it.pkg) return;
+  focused.classList.add("holding");
+  holdTimer = setTimeout(function () {
+    held = true;
+    toggleFav(it);
+  }, 650);
+}
+
+function okUp() {
+  clearTimeout(holdTimer);
+  holdTimer = null;
+  if (focused) focused.classList.remove("holding");
+  if (held) { held = false; return; }
+  if (zone === "menu") { focusContent(); return; }
+  if (focused) bridge.open(focused.dataset.id);
+}
+
+function byId(id) { return items.filter(function (it) { return it.id === id; })[0]; }
+
+function toggleFav(it) {
+  var i = favs.indexOf(it.pkg);
+  if (i >= 0) favs.splice(i, 1);
+  else favs.push(it.pkg);
+  save("favs", favs);
+  toast(i >= 0 ? it.label + " saiu dos favoritos" : it.label + " está nos favoritos");
+  var id = focused && focused.dataset.id;
+  render(section);
+  zone = "content";
+  var again = tiles().filter(function (t) { return t.dataset.id === id; })[0] || tiles()[0];
+  if (again) setFocus(again); else focusMenu(menuIndex);
+}
+
+var toastTimer;
+function toast(text) {
+  var t = document.getElementById("toast");
+  t.textContent = text;
+  t.classList.add("on");
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(function () { t.classList.remove("on"); }, 2200);
+}
+
+document.addEventListener("keydown", function (e) {
+  switch (e.key) {
+    case "ArrowUp": move(0, -1); break;
+    case "ArrowDown": move(0, 1); break;
+    case "ArrowLeft": move(-1, 0); break;
+    case "ArrowRight": move(1, 0); break;
+    case "Enter": okDown(e); break;
+    default: return;
+  }
+  e.preventDefault();
+});
+document.addEventListener("keyup", function (e) {
+  if (e.key === "Enter") { okUp(); e.preventDefault(); }
+});
+
+// MARK: - From the app
+
+window.onBack = function () {
+  if (zone === "content") focusMenu(menuIndex);
+  else if (section !== "home") focusMenu(0);
+};
+
+window.reset = function () {
+  focusMenu(0);
+  render("home");
+};
+
+window.onWeather = function () {
+  loadWeather();
+  if (section === "home") {
+    var id = focused && focused.dataset.id, z = zone;
+    render("home");
+    if (z === "content") {
+      zone = "content";
+      setFocus(tiles().filter(function (t) { return t.dataset.id === id; })[0] || tiles()[0]);
+    } else setFocus(menuButtons()[menuIndex]);
+  }
+};
+
+window.onResume = function () {
+  loadItems();
+  loadWeather();
+  var id = focused && focused.dataset.id, z = zone;
+  render(section);
+  if (z === "content" && id) {
+    zone = "content";
+    var t = tiles().filter(function (x) { return x.dataset.id === id; })[0];
+    if (t) { setFocus(t); return; }
+  }
+  focusMenu(menuIndex);
+};
+
+// MARK: - Start
+
+function mockBridge() {   // a browser without the TV: sample data
+  var apps = [["org.smarttube.stable", "SmartTube", "movies"], ["com.stremio.one", "Stremio", "movies"],
+    ["com.world.youcinetv", "YouCine", "movies"], ["com.google.android.youtube.tv", "YouTube", "movies"],
+    ["com.spotify.tv.android", "Spotify", "music"], ["com.ilv.vradio", "Rádio", "music"],
+    ["nextapp.fx", "FX", "other"], ["com.android.vending", "Play Store", "other"], ["com.substack.app", "Substack", "other"]];
+  return {
+    items: function () {
+      var out = apps.map(function (a) { return { id: "app-" + a[0], kind: "app", label: a[1], pkg: a[0], cat: a[2] }; });
+      out.push({ id: "in-0", kind: "live", label: "TV ao Vivo", symbol: "tv", cat: "live", connected: true });
+      out.push({ id: "in-1", kind: "input", label: "HDMI 1", symbol: "hdmi", cat: "live", connected: false });
+      out.push({ id: "in-2", kind: "input", label: "HDMI 3", symbol: "hdmi", cat: "live", connected: true });
+      out.push({ id: "set-home", kind: "setting", label: "Ajustes do Free My TV", symbol: "sparkles", cat: "settings" });
+      out.push({ id: "set-tv", kind: "setting", label: "Ajustes da TV", symbol: "tv_settings", cat: "settings" });
+      return JSON.stringify(out);
+    },
+    open: function (id) { toast("abrir " + id); },
+    weather: function () {
+      var hours = [["01h", "22°", "clear_night"], ["02h", "22°", "clear_night"], ["03h", "21°", "partly_cloudy_night"],
+        ["04h", "21°", "cloud"], ["05h", "22°", "partly_cloudy_day"], ["06h", "24°", "sunny"]].map(function (h) { return { t: h[0], temp: h[1], icon: h[2] }; });
+      return JSON.stringify({
+        main: { ok: true, city: "Murici", temp: "24°", cond: "Poucas nuvens", icon: "partly_cloudy_night", max: "34°", min: "22°", hours: hours, sunrise: "04:53", sunset: "17:21" },
+        second: { ok: true, city: "Maceió", temp: "26°", cond: "Poucas nuvens", icon: "partly_cloudy_night", max: "30°", min: "24°", hours: hours, sunrise: "04:50", sunset: "17:18" }
+      });
+    },
+    refresh: function () {}
+  };
+}
+
+paintSky(document.getElementById("sky"));
+tick();
+loadItems();
+loadWeather();
+render("home");
+focusMenu(0);
+setInterval(function () { bridge.refresh(); }, 10 * 60000);
